# Signing keys. debug.keystore is throwaway; the upload key is not -- committing it would let
# anyone publish an update as this app, and it cannot be rotated after the fact.
debug.keystore
*.jks
*.keystore

# Intermediate encoder exports (~107 MiB). Regenerate with
# python/export_encoder_onnx.py; only the int8 graph copied into
# app/src/main/assets/models/ is committed.
/python/onnx_export/
/python/__pycache__/

# Inspection data pulled off a phone by scripts/backup-device-data.ps1. Real captured parts
# and real inspection history; it belongs on your machine, not in the repo.
/backups/

# Local development aids. None of these affect what the app does or how it
# builds -- they are assistant context, editor tooling and convenience scripts
# for this machine, so they stay out of the repo.
/CLAUDE.md
/.claude/
/scripts/
