<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_scan"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Aiming frame. Purely advisory: the decoder reads the whole frame, because a QR that
         is in shot but outside a drawn rectangle should still scan rather than appear broken. -->
    <View
        android:id="@+id/view_reticle"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_scan_reticle" />

    <TextView
        android:id="@+id/tv_scan_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:padding="20dp"
        android:text="Point the camera at the QR code on an inspection report."
        android:textColor="@color/white"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Title only. Back is the host chrome's job (activity_main.xml), the same way
             every other fragment leaves it alone. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="SCAN REPORT CODE"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
