<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

  <!-- One scrolling column. It used to be a ConstraintLayout that gave the preview whatever
       height was left between the cards, which on a phone with the count card open was a
       strip a few dp tall. The preview now takes the size the photograph needs (set in code
       to the image's aspect, capped at half the screen) and the rest scrolls beneath it. -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Instruction Panel (Translucent Overlay) -->
    <LinearLayout
        android:id="@+id/layout_instructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D92B2930"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_setup_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MISSING REFERENCE PROFILE"
            android:textColor="@color/orange_warn"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tv_setup_part_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Part ID: PART-CHASSIS-A03"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choose a photo of the MASTER GOLD-STANDARD part, then say how many of each feature it has. The counts decide PASS/FAIL; the positions detected on the photo drive the positional and size checks."
            android:textColor="@color/gray_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Code-uploaded Asset Detector Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_assets_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#1A4ADE80"
        app:cardCornerRadius="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/green_pass">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="@color/green_pass_header"
                    android:contentDescription="Folder info icon" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="IMAGES IN assets/chassis_images/:"
                    android:textColor="@color/green_pass_header"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_assets_folder_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.1"
                android:text="Scanning 'app/src/main/assets/chassis_images/'..." />

            <!-- Horizontal Scroll of files found in assets folder -->
            <HorizontalScrollView
                android:id="@+id/scroll_assets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_assets_container"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Upload Display Area. The zone's width and height are set in code once a photograph
         is chosen (ReferenceSetupFragment.fitPreview) so it has the image's own aspect: the
         overlay stretches its bitmap to the view, so a view of any other shape would draw
         every detection box off its feature. Before a photograph it is a fixed-height
         drop target. -->
    <FrameLayout
        android:id="@+id/layout_preview_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp">

    <FrameLayout
        android:id="@+id/layout_upload_zone"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginHorizontal="16dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/reference_guide_border">

        <!-- Selected Reference Image Preview, shown the moment a photo is chosen -->
        <ImageView
            android:id="@+id/iv_reference_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Selected reference design" />

        <!-- The same overlay the results screen draws: the photo with the detector's boxes on
             it. Replaces the plain preview once the positions have been detected, so the
             operator can see which features localisation will be able to track. -->
        <com.example.ui.view.ChassisOverlayView
            android:id="@+id/overlay_reference_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Placeholder Hint -->
        <LinearLayout
            android:id="@+id/layout_upload_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/blue_primary"
                android:contentDescription="Image upload indicator icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="TAP HERE TO CHOOSE GRAPHIC FILE"
                android:textColor="@color/blue_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select from emulator file storage"
                android:textColor="@color/gray_text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_use_preset_reference"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="USE BUILT-IN REFERENCE PRESET"
                android:textColor="@color/blue_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </FrameLayout>
    </FrameLayout>

    <!-- The operator's declaration of what is on the part. This is the expected side of every
         inspection's count comparison; the reference photograph itself is never analysed. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_expected_features"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WHAT IS ON THIS PART?"
                android:textColor="@color/blue_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Enter how many of each feature the part has. Inspections compare what they detect against these numbers. The photo is detected once, so each feature’s position and size can be checked too."
                android:textColor="@color/gray_text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />

            <!-- What the detector found on the photo, against what was declared. Positions
                 come from here; counts come from the rows below. -->
            <TextView
                android:id="@+id/tv_reference_positions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:visibility="gone"
                tools:text="Detected 4 positions on this photo — all 4 declared features can be localised."
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/layout_expected_type_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_add_feature_type"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="+ Add a feature type"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_expected_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL: 0"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Operator Actions card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_action_deck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/color_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <!-- Opens the chooser until a photo is picked, then confirms photo + counts. The
                 label and enabled state are driven from ReferenceSetupFragment.confirmLabel. -->
            <Button
                android:id="@+id/btn_capture_reference"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/blue_primary"
                android:text="CHOOSE IMAGE"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

  </LinearLayout>
</androidx.core.widget.NestedScrollView>
