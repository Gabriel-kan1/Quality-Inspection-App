<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Instruction Panel (Translucent Overlay) -->
    <LinearLayout
        android:id="@+id/layout_instructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D92B2930"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_setup_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MISSING REFERENCE PROFILE"
            android:textColor="@color/orange_warn"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tv_setup_part_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Part ID: PART-CHASSIS-A03"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choose or upload an acquired image of the MASTER GOLD-STANDARD product. This will establish reference feature patterns of the chassis."
            android:textColor="@color/gray_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Code-uploaded Asset Detector Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_assets_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#1A4ADE80"
        app:cardCornerRadius="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/green_pass"
        app:layout_constraintTop_toBottomOf="@id/layout_instructions">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="@color/green_pass_header"
                    android:contentDescription="Folder info icon" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="IMAGES IN assets/chassis_images/:"
                    android:textColor="@color/green_pass_header"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_assets_folder_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.1"
                android:text="Scanning 'app/src/main/assets/chassis_images/'..." />

            <!-- Horizontal Scroll of files found in assets folder -->
            <HorizontalScrollView
                android:id="@+id/scroll_assets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_assets_container"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Upload Display Area -->
    <FrameLayout
        android:id="@+id/layout_upload_zone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@drawable/reference_guide_border"
        app:layout_constraintTop_toBottomOf="@id/card_assets_folder"
        app:layout_constraintBottom_toTopOf="@id/card_reference_analysis"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Selected Reference Image Preview -->
        <ImageView
            android:id="@+id/iv_reference_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Selected reference design" />

        <!-- Same overlay the inspection screen uses, so the operator sees the reference
             classified exactly as an inspection would classify it. Replaces the flat preview
             once analysis finishes. -->
        <com.example.ui.view.ChassisOverlayView
            android:id="@+id/overlay_reference_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Placeholder Hint -->
        <LinearLayout
            android:id="@+id/layout_upload_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/blue_primary"
                android:contentDescription="Image upload indicator icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="TAP HERE TO CHOOSE GRAPHIC FILE"
                android:textColor="@color/blue_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select from emulator file storage"
                android:textColor="@color/gray_text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_use_preset_reference"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="USE BUILT-IN REFERENCE PRESET"
                android:textColor="@color/blue_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- The highest the analysis card may reach. The photo above it is what the operator counts
         the hardware on and judges the boxes by, so a long analysis scrolls inside its card
         rather than squeezing the photo to a strip. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_analysis_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.55" />

    <!-- What this reference actually contributes: the same detection + classification pass an
         inspection runs, so the operator can see the expected features before saving. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_reference_analysis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="12dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toTopOf="@id/guide_analysis_top"
        app:layout_constraintBottom_toTopOf="@id/card_action_deck"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_reference_analysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPECTED FEATURES IN THIS REFERENCE"
                android:textColor="@color/blue_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- How many features the part should have, asked on the card as soon as a photo
                 is chosen. FIND BEST METHOD tries every edge method and analyses with the one
                 whose count is closest; the row stays, so the count can be corrected and
                 matched again. -->
            <LinearLayout
                android:id="@+id/layout_expected_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/background_dark"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp">

                    <EditText
                        android:id="@+id/et_expected_count"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Feature count"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/gray_text_secondary"
                        android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>

                <Button
                    android:id="@+id/btn_find_method"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/blue_primary"
                    android:text="FIND BEST METHOD"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_skip_count"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="SKIP"
                    android:textColor="@color/gray_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Flips the photo between every edge method's boxes, instantly, so the operator
                 can compare them by eye: nearest their count first. The middle shows which is
                 on the photo and opens the full list. First after the count, so it is in view
                 without scrolling the card. -->
            <LinearLayout
                android:id="@+id/layout_method_switcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <Button
                    android:id="@+id/btn_method_prev"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:backgroundTint="@color/background_dark"
                    android:contentDescription="Previous edge method"
                    android:text="&#9664;"
                    android:textColor="@color/blue_primary"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/layout_method_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/tv_method_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Shipped hybrid pipeline" />

                    <TextView
                        android:id="@+id/tv_method_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textColor="@color/green_pass"
                        android:textSize="11sp"
                        tools:text="IN USE · finds 6 · 1 of 16 ▾" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_method_next"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:backgroundTint="@color/background_dark"
                    android:contentDescription="Next edge method"
                    android:text="&#9654;"
                    android:textColor="@color/blue_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Shown while another method's boxes are on the photo: analyses with it, making
                 it the method this reference is saved with. -->
            <Button
                android:id="@+id/btn_use_method"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/blue_primary"
                android:text="USE THIS METHOD"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_reference_strength_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:textColor="@color/orange_warn"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Matches your count of 6. Use the arrows to compare the other methods' boxes on the photo. The method you save with becomes the one every inspection of this part is measured against." />

            <TextView
                android:id="@+id/tv_reference_analysis_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analysing reference image..."
                android:textColor="@color/white"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:id="@+id/layout_reference_type_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_reference_localisation_readiness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Operator Actions card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_action_deck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/color_border"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <!-- SHUTTER BUTTON -->
            <Button
                android:id="@+id/btn_capture_reference"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/blue_primary"
                android:text="CHOOSE IMAGE"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <!-- Build the few-shot detection library from the selected reference image -->
            <Button
                android:id="@+id/btn_build_library"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="BUILD DETECTION LIBRARY"
                android:textColor="@color/white" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
