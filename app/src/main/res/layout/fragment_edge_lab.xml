<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_edge_lab"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    tools:context=".ui.fragment.EdgeLabFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FBBF24"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="DEBUG TOOL — CHOOSES THE EDGE STAGE INSPECTIONS RUN"
            android:textColor="@color/orange_warn"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.05"
            android:text="EDGE METHOD LAB"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="Runs one photograph through every edge operator at the same working resolution and scores each map through the detector's own geometry filter. Choose USE FOR INSPECTIONS on any card and every inspection and reference setup from then on runs that method — the comparison itself files nothing."
            android:textColor="@color/gray_text_secondary"
            android:textSize="12sp" />

        <!-- What inspections run right now. Stated before any comparison is made, because a
             method chosen here weeks ago is otherwise invisible until a count looks wrong. -->
        <TextView
            android:id="@+id/tv_active_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#3338BDF8"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/blue_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="INSPECTIONS RUN: Shipped hybrid pipeline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_pick_image"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/blue_primary"
                android:contentDescription="Choose an image from this device"
                android:text="CHOOSE IMAGE"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btn_pick_asset"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:backgroundTint="@color/surface_card"
                android:contentDescription="Choose one of the bundled test photographs"
                android:text="TEST PHOTO"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- The source, kept on screen while the maps are read: judging an edge map without
             the photograph beside it is guesswork about what was in the frame. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOURCE"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_source_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/gray_text_secondary"
                    android:textSize="11sp"
                    tools:text="head2.jpg" />

                <ImageView
                    android:id="@+id/iv_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:adjustViewBounds="true"
                    android:background="@color/black"
                    android:contentDescription="The photograph every method below was run on"
                    android:scaleType="fitCenter"
                    tools:src="@android:drawable/ic_menu_gallery" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layout_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="@color/blue_primary" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/gray_text_secondary"
                android:textSize="12sp"
                tools:text="Running nine methods…" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Choose a photograph to compare edge methods on."
            android:textColor="@color/gray_text_secondary"
            android:textSize="13sp" />

        <!-- How to read the numbers. Stated once, above the cards, because the obvious
             reading of the candidate count is the wrong one. -->
        <TextView
            android:id="@+id/tv_reading_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:background="#332B2930"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:text="Candidates are contours that survived the detector's aspect, area and nesting filters — not confirmed fasteners. A higher count is only better if the extra boxes are hardware rather than seams, shadows and glare, so compare the maps as well as the numbers."
            android:textColor="@color/gray_text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/container_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
