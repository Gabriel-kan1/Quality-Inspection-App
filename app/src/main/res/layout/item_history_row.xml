<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="10dp"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Captured thumbnail image frame -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="#22FFFFFF"
            android:padding="2dp">

            <ImageView
                android:id="@+id/iv_record_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="Inspection thumbnail" />
        </FrameLayout>

        <!-- Descriptions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_record_part_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PART-CHASSIS-A03"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15dp" />

            <TextView
                android:id="@+id/tv_record_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2026-06-12 19:30"
                android:textColor="@color/gray_text_secondary"
                android:textSize="12dp" />
        </LinearLayout>

        <!-- Verdict Badge -->
        <TextView
            android:id="@+id/tv_record_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/green_pass"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="PASS"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12dp"
            android:layout_marginEnd="6dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
