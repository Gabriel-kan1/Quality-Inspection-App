<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="24dp"
    tools:context=".ui.fragment.HomeFragment">

    <!-- Top Info Bar / Factory Status -->
    <TextView
        android:id="@+id/tv_operator_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#334ADE80"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Status: Active Offline QC Port"
        android:textColor="@color/green_pass"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- App Logo / Branding Area -->
    <LinearLayout
        android:id="@+id/layout_branding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/tv_operator_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Custom Visual industrial cog/box representation using standard android drawable -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="Inspection Cog Logo"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/blue_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="METAL CHASSIS QC"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="SME Quality Assurance System"
            android:textColor="@color/gray_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Main Operative Action Buttons -->
    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_branding"
        app:layout_constraintVertical_bias="0.6">

        <!-- NEW INSPECTION BUTTON - Primary Action -->
        <Button
            android:id="@+id/btn_new_inspection"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="NEW INSPECTION"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="@color/white"
            android:backgroundTint="@color/blue_primary"
            app:cornerRadius="12dp"
            android:padding="16dp"
            android:contentDescription="Start new inspection"
            android:layout_marginBottom="16dp" />

        <!-- INSPECTION HISTORY BUTTON - Secondary Action -->
        <Button
            android:id="@+id/btn_inspection_history"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="INSPECTION HISTORY"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="@color/white"
            android:backgroundTint="@color/surface_card"
            app:cornerRadius="12dp"
            android:padding="16dp"
            android:contentDescription="View previous inspections history" />
    </LinearLayout>

    <!-- Floor Info Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Database: SQLite (Encrypted/Local Only)"
        android:textColor="@color/gray_text_secondary"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
