<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Top Status panel showing part ID -->
    <RelativeLayout
        android:id="@+id/layout_top_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_operator_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVE INSPECTION"
            android:textColor="@color/blue_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"/>

        <TextView
            android:id="@+id/tv_part_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_operator_tag"
            android:layout_marginTop="2dp"
            android:text="Part ID: PART-CHASSIS-A03"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_ghost_status_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="GHOST OVERLAY ON"
            android:textColor="@color/gray_text_secondary"
            android:textSize="11sp" />
    </RelativeLayout>

    <!-- Code-uploaded Asset Detector Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_assets_folder_inspect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#1A4ADE80"
        app:cardCornerRadius="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/green_pass"
        app:layout_constraintTop_toBottomOf="@id/layout_top_status">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="@color/green_pass_header"
                    android:contentDescription="Folder info icon" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="IMAGES IN assets/chassis_images/:"
                    android:textColor="@color/green_pass_header"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_assets_folder_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.1"
                android:text="Scanning 'app/src/main/assets/chassis_images/'..." />

            <!-- Horizontal Scroll of files found in assets folder -->
            <HorizontalScrollView
                android:id="@+id/scroll_assets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_assets_container"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/layout_camera_enclosure"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:background="@drawable/align_border_red"
        app:layout_constraintBottom_toTopOf="@id/card_operator_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_assets_folder_inspect">

        <FrameLayout
            android:id="@+id/layout_interactive_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#222B2930">

            <!-- Live camera feed. Sits at the bottom of the stack so a chosen still image
                 covers it when the operator inspects from assets or the gallery instead. -->
            <androidx.camera.view.PreviewView
                android:id="@+id/preview_camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:scaleType="fitCenter" />

            <!-- Selected Active Chassis Image under inspection -->
            <ImageView
                android:id="@+id/iv_chassis_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="Inspection target image preview" />

            <!-- Ghost overlay: the reference over the live image, as its edges alone (default),
                 as the tinted photograph, or as the plain photograph. Bitmap, colour filter and alpha are all set per
                 mode in InspectionFragment.renderGhost(); see GhostMode for the cycle. -->
            <ImageView
                android:id="@+id/iv_ghost_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Reference product ghost overlay"
                android:visibility="gone" />

            <!-- Placeholder Hint -->
            <LinearLayout
                android:id="@+id/layout_upload_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/blue_primary"
                    android:contentDescription="Gallery vector indicator" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="TAP TO UPLOAD ACTIVE CHASSIS PHOTO"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="From the gallery, the camera or a bundled test photo"
                    android:textColor="@color/gray_text_secondary"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_use_preset_inspection"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="CHOOSE IMAGE"
                    android:textColor="@color/blue_primary"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Status Indicator Overlay (Top Right in Preview) -->
            <TextView
                android:id="@+id/tv_alignment_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:background="#D9F87171"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="ALIGNING..."
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <!-- Alignment traffic light. Left edge, vertically centred: out of the way of
                 the part itself but inside the operator's view of the preview. -->
            <com.example.ui.view.TrafficLightView
                android:id="@+id/view_traffic_light"
                android:layout_width="28dp"
                android:layout_height="84dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:visibility="gone"
                android:contentDescription="Alignment status indicator" />

            <!-- Directional instruction, e.g. MOVE CLOSER. -->
            <TextView
                android:id="@+id/tv_alignment_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="20dp"
                android:background="#B3000000"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:text="POINT AT THE PART"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:visibility="gone" />

            <!-- Live numbers behind a long-press on the hint, for threshold tuning. -->
            <TextView
                android:id="@+id/tv_alignment_debug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="4dp"
                android:background="#99000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/blue_secondary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:visibility="gone" />

            <!-- Shown when the part has no reference photo: nothing to align against, so
                 inspection is blocked rather than silently ungated. -->
            <LinearLayout
                android:id="@+id/layout_no_reference"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:background="#E6141419"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    app:tint="@color/orange_warn"
                    android:contentDescription="No reference warning" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="NO REFERENCE IMAGE"
                    android:textColor="@color/orange_warn"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Alignment cannot be verified without a reference photo for this part, so inspection is blocked. Capture a reference first."
                    android:textColor="@color/gray_text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.2" />

                <Button
                    android:id="@+id/btn_go_to_reference_setup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/blue_primary"
                    android:text="SET UP REFERENCE"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>

        </FrameLayout>
    </FrameLayout>

    <!-- Bottom Operator Deck -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_operator_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/color_border"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_operator_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gray_text_secondary"
                android:textSize="13sp"
                android:text="Upload photo first to lock virtual coordinate alignment"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="3">

                <!-- Cycles the ghost: OUTLINE -> TINTED -> PLAIN -> OFF. Label names the current state. -->
                <Button
                    android:id="@+id/btn_toggle_ghost"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="GHOST: OUTLINE"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <!-- SHUTTER BUTTON -->
                <Button
                    android:id="@+id/btn_capture_inspect"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="2"
                    android:backgroundTint="@color/blue_primary"
                    android:text="CHOOSE IMAGE"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Switches between the live camera gate and inspecting a saved still, which
                 is the only way to exercise the pipeline on an emulator. -->
            <TextView
                android:id="@+id/tv_mode_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="6dp"
                android:text="Inspect a saved image instead"
                android:textColor="@color/blue_secondary"
                android:textSize="11sp"
                android:gravity="center"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
