<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Report Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@color/blue_primary"
                android:contentDescription="Report Emblem" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSPECTION REPORT"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_report_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report ID: QC-RECORD-289"
                    android:textColor="@color/gray_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Core Record Stats Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Part ID Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Part ID"
                        android:textColor="@color/gray_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_report_part_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="PART-CHASSIS-A03"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                </RelativeLayout>

                <!-- Timestamp Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inspection Date"
                        android:textColor="@color/gray_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_report_timestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="2026-06-12 19:30"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </RelativeLayout>

                <!-- Verdict Badge -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Final Verdict"
                        android:textColor="@color/gray_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_report_verdict"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@color/green_pass"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="PASS"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </RelativeLayout>

                <!-- Optional Operator Notes -->
                <LinearLayout
                    android:id="@+id/layout_report_notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1BFFFFFF"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Operator Log / Notes"
                        android:textColor="@color/gray_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_report_notes_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chassis panel batch 5. No physical dents detected. Coating optimal."
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- The two photos the verdict came from, side by side and each labelled, so a reader
             never has to guess which is the standard and which is the part that was checked.
             Tap either to see it full screen. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHOTOS COMPARED  ·  TAP TO ENLARGE"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/blue_primary"
                            android:gravity="center"
                            android:paddingVertical="6dp"
                            android:text="REFERENCE PHOTO"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="The standard: a correct part"
                            android:textColor="@color/gray_text_secondary"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/iv_report_reference"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginTop="6dp"
                            android:background="@color/black"
                            android:contentDescription="REFERENCE PHOTO: The standard: a correct part"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/tv_report_reference_caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/orange_warn"
                            android:gravity="center"
                            android:paddingVertical="6dp"
                            android:text="INSPECTION PHOTO"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="The part that was checked"
                            android:textColor="@color/gray_text_secondary"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/iv_report_inspection"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginTop="6dp"
                            android:background="@color/black"
                            android:contentDescription="INSPECTION PHOTO: The part that was checked"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/tv_report_inspection_caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Feature Details Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUANTIFICATION RECORD SUMMARY"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Vertical breakdown elements dynamically popped or hardcoded. Long term they load from feature-result list. Let's make it fully dynamic! -->
                <LinearLayout
                    android:id="@+id/layout_report_features_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- This is dynamically populated inside Fragment. For preview we can fall back to nice placeholders. -->

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Critical Feature Localisation: one row per expected position. Hidden when the
             inspection produced no positional findings (no reference layout, or the photo
             could not be registered onto it). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_report_localisation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CRITICAL FEATURE LOCALISATION"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_report_localisation_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layout_report_localisation_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Warning Notes: advisory-severity types, trended against this part's history
             rather than counted. Hidden entirely when there are no advisory types. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_report_warnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WARNING NOTES"
                    android:textColor="@color/amber_advisory"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Non-critical findings. Tracked as trends against this part's history; they do not affect the pass/fail verdict."
                    android:textColor="@color/gray_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layout_report_warnings_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Traceability. Mirrors the block on the generated PDF, so the code is scannable
             straight off the screen instead of only out of an exported file — which is what
             makes History > SCAN usable without a printer. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_report_traceability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="TRACEABILITY"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_report_integrity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textColor="@color/gray_text_secondary"
                    android:textSize="11sp"
                    tools:text="Sealed. SHA-256 9f86d081…" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- White plate behind the symbol: the card is dark, and a QR needs its
                         quiet zone to be light or the finder patterns lose their border. -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/iv_report_qr"
                            android:layout_width="132dp"
                            android:layout_height="132dp"
                            android:contentDescription="QR code identifying this inspection" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="RECORD ID"
                            android:textColor="@color/gray_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_report_uuid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            tools:text="3f2504e0-4f89-41d3-9a0c-0305e82c3301" />

                        <TextView
                            android:id="@+id/tv_report_code_payload"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:textColor="@color/gray_text_secondary"
                            android:textSize="10sp"
                            tools:text="QCRAE7SKBHAJ6EUDU42BQBQL2BMGMAQCAAAAAAAAAAAAA" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Scan from History &gt; SCAN to reopen this inspection."
                            android:textColor="@color/gray_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Actions Deck -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="40dp">

            <!-- EXPORT TO PDF -->
            <Button
                android:id="@+id/btn_export_pdf"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/blue_primary"
                android:text="EXPORT REPORT AS PDF"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- EXPORT DATA. Separate from the PDF button because it answers a different
                 need: the PDF is for a person to read and file, this is for the numbers to
                 reach a spreadsheet or an ERP without being retyped off the page. -->
            <Button
                android:id="@+id/btn_export_data"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="EXPORT DATA (JSON + CSV)"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <!-- SHARE REPORT -->
            <Button
                android:id="@+id/btn_share_report"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="SHARE INSPECTION METRIC"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <!-- DONE / RETURN TO HOME -->
            <Button
                android:id="@+id/btn_report_done"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="COMPLETE &amp; RETURN TO DASHBOARD"
                android:textColor="@color/blue_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
