<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Report Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@color/blue_primary"
                android:contentDescription="Report Emblem" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSPECTION REPORT"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_report_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report ID: QC-RECORD-289"
                    android:textColor="@color/gray_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Core Record Stats Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Part ID Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Part ID"
                        android:textColor="@color/gray_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_report_part_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="PART-CHASSIS-A03"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                </RelativeLayout>

                <!-- Timestamp Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inspection Date"
                        android:textColor="@color/gray_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_report_timestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="2026-06-12 19:30"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </RelativeLayout>

                <!-- Verdict Badge -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Final Verdict"
                        android:textColor="@color/gray_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_report_verdict"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@color/green_pass"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="PASS"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </RelativeLayout>

                <!-- Optional Operator Notes -->
                <LinearLayout
                    android:id="@+id/layout_report_notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1BFFFFFF"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Operator Log / Notes"
                        android:textColor="@color/gray_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_report_notes_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chassis panel batch 5. No physical dents detected. Coating optimal."
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Feature Details Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUANTIFICATION RECORD SUMMARY"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Vertical breakdown elements dynamically popped or hardcoded. Long term they load from feature-result list. Let's make it fully dynamic! -->
                <LinearLayout
                    android:id="@+id/layout_report_features_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- This is dynamically populated inside Fragment. For preview we can fall back to nice placeholders. -->

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Actions Deck -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="40dp">

            <!-- EXPORT TO PDF -->
            <Button
                android:id="@+id/btn_export_pdf"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/blue_primary"
                android:text="EXPORT REPORT AS PDF"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- SHARE REPORT -->
            <Button
                android:id="@+id/btn_share_report"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="SHARE INSPECTION METRIC"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <!-- DONE / RETURN TO HOME -->
            <Button
                android:id="@+id/btn_report_done"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="COMPLETE &amp; RETURN TO DASHBOARD"
                android:textColor="@color/blue_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
