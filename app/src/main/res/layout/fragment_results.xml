<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Large PASS/FAIL Indicator Header Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_result_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/layout_result_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/green_pass_header"
                android:padding="20dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_result_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSPECTION PASSED"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tv_result_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="All expected features verified successfully."
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Canny Edges & Filtering Card (collapsible — diagnostic view, off by default) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/gray_text_secondary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Tap anywhere on this row to show or hide the edge preview below -->
                <LinearLayout
                    android:id="@+id/header_canny_edges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CANNY EDGES &amp; FILTERING"
                        android:textColor="@color/gray_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp"/>

                    <TextView
                        android:id="@+id/tv_canny_edges_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#9656;"
                        android:textColor="@color/gray_text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp"/>

                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_canny_edges"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:scaleType="fitCenter"
                    android:background="@color/black"
                    android:visibility="gone"
                    tools:srcCompat="@tools:sample/backgrounds/scenic"
                    tools:visibility="visible" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Computer Vision Graphical Analysis View Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/blue_primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DETECTION SPATIAL OVERLAY"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap any box to correct a wrong label"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Custom Drawing view showing bounding box outlines -->
                <com.example.ui.view.ChassisOverlayView
                    android:id="@+id/chassis_overlay_view"
                    android:layout_width="match_parent"
                    android:layout_height="280dp" />

                <!-- Legends Row (populated dynamically per detected feature type) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layout_legend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center" />
                </HorizontalScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Summary Table Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FEATURES QUANTITATIVE REPORT"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Table Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp"
                    android:weightSum="4"
                    android:background="#1F0A84FF">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:text="Feature Type"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:gravity="start"
                        android:paddingStart="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:text="Expected"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:text="Detected"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:text="Status"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Feature rows (one per detected/expected feature type, built at runtime) -->
                <LinearLayout
                    android:id="@+id/layout_feature_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Critical Feature Localisation (populated at runtime) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/gray_text_secondary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CRITICAL FEATURE LOCALISATION"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_localisation_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registering against the reference layout..."
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

                <LinearLayout
                    android:id="@+id/layout_localisation_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dimensional Measurement (populated at runtime) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/gray_text_secondary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIMENSIONAL MEASUREMENT"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_calibration_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Checking for calibration marker..."
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

                <LinearLayout
                    android:id="@+id/layout_measurement_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Self-Learning Loop Status (populated at runtime) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/gray_text_secondary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ON-DEVICE LEARNING"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_learning_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Collecting classification history..."
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Operators Notes Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/text_input_layout_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Log Operator Notes (Optional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_inspection_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dynamic Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="40dp">

            <!-- INSPECT AGAIN - Abort / Retry -->
            <Button
                android:id="@+id/btn_inspect_again"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="0.8"
                android:text="RETRY"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp" />

            <!-- SAVE REPORT - Primary database submission -->
            <Button
                android:id="@+id/btn_save_report"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1.2"
                android:backgroundTint="@color/blue_secondary"
                android:textColor="@color/blue_dark_accent"
                android:text="SAVE REPORT"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
