<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PART SPECIFICATION"
            android:textColor="@color/gray_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select Profile or Enter ID"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enter unique automotive chassis ID manually to trace alignment references."
            android:textColor="@color/gray_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Selection/Input Panel Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_input_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/color_border"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintBottom_toTopOf="@id/card_bottom_deck">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANUAL IDENTIFIER INPUT"
                android:textColor="@color/blue_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- Elegant Manual Input EditText Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_part_container"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Chassis ID (e.g. CHASSIS-8821-B)"
                app:boxBackgroundColor="#15FFFFFF"
                app:boxStrokeColor="@color/blue_primary"
                app:hintTextColor="@color/blue_primary"
                app:placeholderText="Enter part identifier...">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_part_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:singleLine="true"
                    android:text="CHASSIS-8821-B"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="PRE-CONFIGURED TESTING PROFILES"
                android:textColor="@color/gray_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Quick-select preset part templates for emulator testing:"
                android:textColor="@color/gray_text_secondary"
                android:textSize="12sp" />

            <!-- Selectable Part Preset Chips/Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btn_preset_1"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="CHASSIS-8821-B"
                    android:textColor="@color/blue_primary"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_preset_2"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="PART-CHASSIS-A03"
                    android:textColor="@color/blue_primary"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_preset_3"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="ENGINE-COV-X42"
                    android:textColor="@color/blue_primary"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Action Deck -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_deck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/color_border"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <!-- Confirm and Proceed -->
            <Button
                android:id="@+id/btn_confirm_part"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/blue_secondary"
                android:text="VERIFY PROFILES &amp; CONTINUE"
                android:textColor="@color/blue_dark_accent"
                android:textStyle="bold" />

            <!-- Lets an operator replace a reference photo that was already saved for this
                 part, instead of being routed straight past setup into inspection. -->
            <Button
                android:id="@+id/btn_change_reference"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="CHOOSE A DIFFERENT REFERENCE IMAGE"
                android:textColor="@color/blue_primary"
                android:textStyle="bold"
                app:strokeColor="@color/color_border" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
