<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Camera Preview for Scanning -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Status / Mode Indicator -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#99121214"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="SCAN PART BARCODE"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Barcode Box Scanning Overlay View (Guide Frame) -->
    <View
        android:id="@+id/barcode_guide_frame"
        android:layout_width="280dp"
        android:layout_height="180dp"
        android:background="@drawable/barcode_guide_border"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4" />

    <TextView
        android:id="@+id/tv_guide_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Align barcode within this frame"
        android:textColor="@color/blue_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:shadowColor="@color/black"
        android:shadowRadius="3"
        android:shadowDx="1"
        android:shadowDy="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barcode_guide_frame" />

    <!-- Bottom Operator Deck -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_deck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <!-- Scanning State Panel -->
            <LinearLayout
                android:id="@+id/layout_scanning_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="visible">

                <ProgressBar
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:textColor="@color/blue_primary"/>

                <TextView
                    android:id="@+id/tv_scan_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Searching for barcode..."
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Detected State Panel -->
            <LinearLayout
                android:id="@+id/layout_detected_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PART ID DETECTED"
                    android:textColor="@color/green_pass"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <!-- Large readable scanned ID -->
                <TextView
                    android:id="@+id/tv_detected_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="PART-10029-A"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:weightSum="2">

                    <!-- Requery Button -->
                    <Button
                        android:id="@+id/btn_rescan"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="0.8"
                        android:text="RE-SCAN"
                        android:textColor="@color/white"
                        android:layout_marginEnd="8dp" />

                    <!-- Confirm and Proceed -->
                    <Button
                        android:id="@+id/btn_confirm_part"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="@color/blue_primary"
                        android:text="CONFIRM &amp; CONTINUE"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Manual Entry / Skip for Mocking -->
            <Button
                android:id="@+id/btn_skip_mock"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Simulate Barcode Detect (PART-CHASSIS-A03)"
                android:textColor="@color/blue_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
