<?xml version="1.0" encoding="utf-8"?>
<!--
    One operator's result. Inflated once per method by EdgeLabFragment.

    The map is the point of the card, so it gets the width and the numbers sit above it: the
    counts only mean something once you have looked at what produced them.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_method"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="16dp"
    app:strokeWidth="0dp"
    app:strokeColor="@color/blue_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_method_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Hybrid v6" />

            <!-- Only shown on the row that is the production pipeline, so the others are
                 read as alternatives to something rather than as nine equal options. -->
            <TextView
                android:id="@+id/tv_method_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#3338BDF8"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="SHIPPED"
                android:textColor="@color/blue_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- The method inspections currently run. Independent of SHIPPED: the shipped
                 stack is what runs until somebody chooses otherwise, and after that it is
                 still the shipped stack, just not the one in use. -->
            <TextView
                android:id="@+id/tv_method_in_use"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#334ADE80"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="IN USE"
                android:textColor="@color/green_pass"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Only on the rung the photograph's own measurements pick, so the operator can find
             the card an adaptive inspection would actually run without matching numbers. -->
        <TextView
            android:id="@+id/tv_method_picked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#33FBBF24"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="ADAPTIVE RUNS THIS FOR THIS PHOTO"
            android:textColor="@color/orange_warn"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_method_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/blue_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="14 candidates  ·  318 contours  ·  3.41% edge  ·  86 ms" />

        <!-- Only the adaptive entry sets this: which rung it ran on this photo and why. -->
        <TextView
            android:id="@+id/tv_method_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/green_pass"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="MEDIUM preprocessing — noise 3.3, edge contrast 121 (no reference sizes to test against)" />

        <!-- In brief, before the long account below: what the method is good at and the
             key steps it runs. -->
        <TextView
            android:id="@+id/tv_method_brief"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            tools:text="Good at: Accuracy: the best overall, exact on 20 of 26 test photos.
Uses: CLAHE · bilateral 5 · Canny at 1.1x Otsu" />

        <TextView
            android:id="@+id/tv_method_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/gray_text_secondary"
            android:textSize="11sp"
            tools:text="The same operator with its two thresholds derived per image from Otsu." />

        <!-- Black plate: these are white-on-black binary maps, and the card colour behind a
             letterboxed image would read as part of the map. -->
        <ImageView
            android:id="@+id/iv_method_edges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:background="@color/black"
            android:contentDescription="Edge map produced by this method"
            android:scaleType="fitCenter"
            tools:src="@android:drawable/ic_menu_gallery" />

        <!-- What an inspection would do with this map: where its boxes fall on the photograph,
             then the crops it would hand the encoder, numbered alike. The map alone does not
             say which blobs survive the geometry filter, or what the classifier would see. -->
        <TextView
            android:id="@+id/tv_crops_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="WHAT THE INSPECTION WOULD CROP"
            android:textColor="@color/blue_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_crops_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/gray_text_secondary"
            android:textSize="11sp"
            tools:text="An inspection would crop and classify 6 features:" />

        <com.example.ui.view.BoxOverlayImageView
            android:id="@+id/iv_method_boxes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:background="@color/black"
            android:contentDescription="The photograph with this method's detections outlined"
            android:scaleType="fitCenter" />

        <HorizontalScrollView
            android:id="@+id/scroll_crops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/container_crops"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Makes this method the edge stage for every inspection and reference setup that
             follows. Disabled on the card already in use, so the state reads from the button
             as well as the badge. -->
        <Button
            android:id="@+id/btn_use_method"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/blue_primary"
            android:text="USE FOR INSPECTIONS"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
