<?xml version="1.0" encoding="utf-8"?>
<!-- A bordered well for a short numeric entry on a dark card. The default EditText
     underline vanishes against surface_card; a filled, outlined box reads as a field. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/background_dark" />
    <stroke
        android:width="1dp"
        android:color="@color/color_border" />
    <corners android:radius="8dp" />
</shape>
