<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and transfer rules. See android:allowBackup in AndroidManifest.xml for
    the reasoning: nothing this app stores should leave the device automatically.

    allowBackup="false" already disables cloud backup, but it does NOT disable device-to-device
    transfer, so every domain holding inspection data is excluded explicitly below:
      database    - the Room inspection history
      external    - captured_inspections/, references/ and reports/ under getExternalFilesDir()
      file        - the learned reference libraries, layouts, thresholds and training crops
      sharedpref  - operator settings
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="external" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="external" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
