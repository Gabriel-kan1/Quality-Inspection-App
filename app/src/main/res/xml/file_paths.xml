<?xml version="1.0" encoding="utf-8"?>
<!--
    Two folders, deliberately no more: the generated PDF reports, which are shared out of this
    app, and the reference photos, which the camera app writes into when the operator takes one
    during reference setup. A broader mapping (an <external-path> at "." covers the whole of
    shared storage) would put every file the user owns behind a URI this app is able to grant,
    for no gain.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="reports" path="reports/" />
    <external-files-path name="references" path="references/" />
</paths>
